+// ggml_compute_forward_dsv41_gather_kv (Strata-DS4, strix-port): the window rows, the selected compressed rows (the
+// type's to_float, as get_rows) and zero pad rows of every query, converted to F16 as ggml_cpu_fp32_to_fp16 (the cpy)
+void ggml_compute_forward_dsv41_gather_kv(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * wsrc = dst->src[0];
+    const ggml_tensor * widx = dst->src[1];
+    const ggml_tensor * comp = dst->src[2];
+    const ggml_tensor * sel  = dst->src[3];
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && wsrc->type == GGML_TYPE_F32 && wsrc->nb[0] == sizeof(float));
+    const int64_t dh = dst->ne[0], m_pad = dst->ne[1], n = dst->ne[3];
+    const int64_t swa = ggml_get_op_params_i32(dst, 0), k = sel ? sel->ne[0] : 0;
+    ggml_to_float_t to_float = comp ? ggml_get_type_traits(comp->type)->to_float : nullptr;
+    std::vector<float> tmp((size_t) dh);
+    const int64_t nr = m_pad * n;
+    for (int64_t ir = nr * params->ith / params->nth; ir < nr * (params->ith + 1) / params->nth; ++ir) {
+        const int64_t t = ir / m_pad, row = ir % m_pad;
+        ggml_fp16_t * y = (ggml_fp16_t *) ((char *) dst->data + ir * dst->nb[1]);
+        const float * x = tmp.data();
+        if (row < swa) {
+            x = (const float *) ((const char *) wsrc->data + (size_t) ((const int32_t *) widx->data)[t * swa + row] * wsrc->nb[1]);
+        } else if (row < swa + k) {
+            const int32_t r = ((const int32_t *) ((const char *) sel->data + (size_t) t * sel->nb[1]))[row - swa];
+            const char * src = (const char *) comp->data + (size_t) r * comp->nb[1];
+            if (comp->type == GGML_TYPE_F32) x = (const float *) src;
+            else to_float(src, tmp.data(), dh);
+        } else {
+            std::fill(tmp.begin(), tmp.end(), 0.0f);
+        }
+        ggml_cpu_fp32_to_fp16(x, y, dh);
+    }
+}
