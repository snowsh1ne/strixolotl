+#include "dsv41-gather-kv.cuh"
+#include "dequantize.cuh"
+#include "convert.cuh"
+
+// Strata DS4.1 (strix-port, docs/PREFILL.md #2): each query's attention keys in ONE pass, F16, padded - the values of
+//   cast_f16(pad(concat(get_rows(wsrc, widx), get_rows(comp, sel)), m_pad))
+// bit for bit: window rows F32 -> F16 (ggml_cuda_cast, as the cpy), NVFP4 rows ue4m3(d) * kvalues -> F16 (dequantize_nvfp4<half>,
+// the get_rows kernel's own dequantizer), pad rows 0.  One warp writes one key row (DH halves).
+template <bool nvfp4>
+static __global__ void k_dsv41_gather_kv(
+        const float * __restrict__ wsrc, const int32_t * __restrict__ widx, const char * __restrict__ comp,
+        const char * __restrict__ sel, half * __restrict__ dst,
+        const int64_t dh, const int64_t swa, const int64_t k, const int64_t m_pad, const int64_t n,
+        const size_t ws1, const size_t cs1, const size_t ss1) {
+    const int64_t row = (int64_t) blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    const int64_t t   = blockIdx.y;
+    if (row >= m_pad || t >= n) {
+        return;
+    }
+    const int lane = threadIdx.x % WARP_SIZE;
+    half * y = dst + (t*m_pad + row)*dh;
+    if (row < swa) {
+        const float * x = (const float *) ((const char *) wsrc + (size_t) widx[t*swa + row]*ws1);
+        for (int64_t i = lane; i < dh; i += WARP_SIZE) {
+            y[i] = ggml_cuda_cast<half>(x[i]);
+        }
+    } else if (row < swa + k) {
+        const int32_t r = ((const int32_t *) (sel + (size_t) t*ss1))[row - swa];
+        const char * x = comp + (size_t) r*cs1;
+        if constexpr (nvfp4) {
+            for (int64_t ib = 0; ib < dh/QK_K; ++ib) {
+                dequantize_nvfp4<half>(x, ib, y + ib*QK_K, lane);
+            }
+        } else {
+            const float * xf = (const float *) x;
+            for (int64_t i = lane; i < dh; i += WARP_SIZE) {
+                y[i] = ggml_cuda_cast<half>(xf[i]);
+            }
+        }
+    } else {
+        for (int64_t i = lane; i < dh; i += WARP_SIZE) {
+            y[i] = ggml_cuda_cast<half>(0.0f);
+        }
+    }
+}
+
+void ggml_cuda_op_dsv41_gather_kv(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * wsrc = dst->src[0];
+    const ggml_tensor * widx = dst->src[1];
+    const ggml_tensor * comp = dst->src[2];
+    const ggml_tensor * sel  = dst->src[3];
+    const int64_t swa   = ggml_get_op_params_i32(dst, 0);
+    const int64_t m_pad = dst->ne[1];
+    const int64_t n     = dst->ne[3];
+    const int64_t dh    = dst->ne[0];
+    const int64_t k     = sel ? sel->ne[0] : 0;
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && ggml_is_contiguous(dst));
+    GGML_ASSERT(wsrc->type == GGML_TYPE_F32 && wsrc->ne[0] == dh && wsrc->nb[0] == sizeof(float));
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && ggml_is_contiguous(widx));
+    GGML_ASSERT(dh % QK_K == 0);
+    const bool nvfp4 = comp && comp->type == GGML_TYPE_NVFP4;
+    cudaStream_t stream = ctx.stream();
+    const int rows_per_block = 8;
+    const dim3 grid((unsigned) ((m_pad + rows_per_block - 1)/rows_per_block), (unsigned) n, 1);
+    const dim3 block(rows_per_block*WARP_SIZE, 1, 1);
+    const char * cd = comp ? (const char *) comp->data : nullptr;
+    const char * sd = sel  ? (const char *) sel->data  : nullptr;
+    const size_t cs1 = comp ? comp->nb[1] : 0, ss1 = sel ? sel->nb[1] : 0;
+    if (nvfp4) {
+        k_dsv41_gather_kv<true><<<grid, block, 0, stream>>>((const float *) wsrc->data, (const int32_t *) widx->data, cd, sd,
+            (half *) dst->data, dh, swa, k, m_pad, n, wsrc->nb[1], cs1, ss1);
+    } else {
+        k_dsv41_gather_kv<false><<<grid, block, 0, stream>>>((const float *) wsrc->data, (const int32_t *) widx->data, cd, sd,
+            (half *) dst->data, dh, swa, k, m_pad, n, wsrc->nb[1], cs1, ss1);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool ggml_cuda_dsv41_gather_kv_supported(const ggml_tensor * op) {
+    const ggml_tensor * wsrc = op->src[0], * widx = op->src[1], * comp = op->src[2], * sel = op->src[3];
+    if (op->type != GGML_TYPE_F16 || wsrc->type != GGML_TYPE_F32 || widx->type != GGML_TYPE_I32) return false;
+    if (op->ne[0] % QK_K != 0 || wsrc->nb[0] != sizeof(float) || !ggml_is_contiguous(widx)) return false;
+    if ((comp == nullptr) != (sel == nullptr)) return false;
+    if (comp && !(comp->type == GGML_TYPE_NVFP4 || (comp->type == GGML_TYPE_F32 && comp->nb[0] == sizeof(float)))) return false;
+    if (sel && (sel->type != GGML_TYPE_I32 || sel->nb[0] != sizeof(int32_t))) return false;
+    return true;
+}
