# scripts/v41_1017.env - environment for tools/v41's quantization pipeline on DeepSeek-V4.1-Flash-1017 (Strix Halo).
# Source it inside the xolotl-quant toolbox:   . scripts/v41_1017.env
# Then e.g.  python3 xolotl/tools/v41/v41_calib.py prep ...   /   bash xolotl/tools/v41/calib_layers.sh 0 39
_V41_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
_V41_M="${XOLOTL_MODELS:-$HOME/models/xolotl}"
export V41_SRC="$_V41_M/DeepSeek-V4.1-Flash-1017"                        # fetch_1017_fp8; every file has its .ok
export V41_REF="$V41_SRC/inference"                                      # DeepSeek's model.py + inference config
export V41_ENCODING="$V41_SRC/encoding/encoding.py"                      # the 1017's own chat renderer (build_corpus)
export V41_WORK="${V41_WORK:-$_V41_M/v41-work/calib-1017}"               # calibration chain (~47 GiB peak, local NVMe)
export V41_ANTIREZ="$HOME/.cache/xolotl/calib-refs/antirez-ds4-imatrix/dataset/prompts.jsonl"   # antirez/ds4 @ fc80bd69
export V41_SESSION_ROOTS="$HOME/.claude/projects:$HOME/.cache/xolotl/calib-refs/claude_logs/projects"   # + dev server's (claude_logs/)
export V41_CODE_GLOBS="$_V41_REPO/xolotl/src/**/*.cpp:$_V41_REPO/xolotl/src/**/*.cu:$_V41_REPO/xolotl/tools/**/*.py"
export V41_DOC_GLOBS="$_V41_REPO/xolotl/*.md:$_V41_REPO/xolotl/docs/*.md:$_V41_REPO/xolotl/docs/**/*.md"
export V41_GGUF_PY="$HOME/.cache/xolotl/llama.cpp/gguf-py"               # patched gguf-py (v41_sidecar)
export V41_SRC_NAME="DeepSeek V4.1 Flash 1017 (Strata v41 GSQ mixed tier)"
export V41_SRC_URL="https://huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash-1017"
export V41_ACT_ORDER=1
export DS4_LOCK="$HOME/.cache/xolotl/ds4-gpu.lock"                       # calib/quant drivers + memguard
export PYTHONPYCACHEPREFIX="$HOME/.cache/xolotl/pycache"                 # no __pycache__ on the NFS share
export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"                   # pile-10k is cached once (prep)
unset _V41_REPO _V41_M
